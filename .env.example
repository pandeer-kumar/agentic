# Azure OpenAI. These defaults target the bundled mock (run: opsagent-mock-azure).
# For real Azure, replace all four values.
AZURE_OPENAI_ENDPOINT=http://127.0.0.1:8900
AZURE_OPENAI_API_KEY=mock-key
AZURE_OPENAI_DEPLOYMENT=mock-gpt
AZURE_OPENAI_API_VERSION=2024-10-21

# Matches docker-compose.yml
DATABASE_URL=postgresql://agentic:agentic_dev@127.0.0.1:5433/agentic

# Agent limits
AGENT_MAX_STEPS=12
MAX_RECORDS_PER_FETCH=5000
